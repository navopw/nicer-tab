{
	"name": "nicer-tab",
	"description": "A beautiful bookmark organizer for your new tab page",
	"version": "0.1.0",
	"author": "navopw",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/navopw/nicer-tab.git"
	},
	"bugs": {
		"url": "https://github.com/navopw/nicer-tab/issues"
	},
	"homepage": "https://github.com/navopw/nicer-tab#readme",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md,html}": "prettier --write"
	},
	"dependencies": {
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"lucide-react": "^0.563.0",
		"react": "^19.2.8",
		"react-colorful": "^5.8.0",
		"react-dom": "^19.2.8",
		"zustand": "^5.0.14"
	},
	"overrides": {
		"uuid": "^11.1.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/chrome": "^0.2.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@wxt-dev/module-react": "^1.1.5",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"wxt": "^0.20.27"
	}
}
